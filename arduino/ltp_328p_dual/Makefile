# LTP 328P Dual Strip - Arduino Build Makefile
#
# ATmega328P with two LED strips (WS2812 + APA102) and two buttons.
# Only one strip active at a time, switchable via protocol control.
#
# Uses arduino-cli for building.
#
# First-time setup:
#   make setup
#
# Build and upload:
#   make upload PORT=/dev/ttyUSB0

# Configuration
BOARD ?= arduino:avr:nano:cpu=atmega328old
PORT ?= /dev/ttyUSB0
BAUD ?= 115200

# Sketch info
SKETCH = ltp_328p_dual.ino
BUILD_DIR = build

# Tools
CLI = arduino-cli

# Version info (embedded at compile time via generated build_info.cpp)
GIT_COMMIT := $(shell git rev-parse --short=7 HEAD 2>/dev/null || echo "unknown")$(shell git diff --quiet 2>/dev/null || echo "+")
BUILD_DATE := $(shell date +%Y%m%d)
BUILD_INFO_CPP = build_info.cpp

# Shared libraries directory
LIBRARIES = ../libraries

.PHONY: all build upload clean setup monitor help build-info

# Default target
all: build

# Generate build_info.cpp with version stamps
build-info:
	@echo "// Auto-generated by Makefile - do not edit" > $(BUILD_INFO_CPP)
	@echo "const char* GIT_COMMIT = \"$(GIT_COMMIT)\";" >> $(BUILD_INFO_CPP)
	@echo "const char* BUILD_DATE = \"$(BUILD_DATE)\";" >> $(BUILD_INFO_CPP)

# First-time setup - install Arduino AVR core
setup:
	$(CLI) config init || true
	$(CLI) core update-index
	$(CLI) core install arduino:avr
	@echo ""
	@echo "Setup complete. Arduino AVR core installed."

# ============================================================================
# Build targets
# ============================================================================

build: build-info
	$(CLI) compile --fqbn $(BOARD) --libraries $(LIBRARIES) --build-path $(BUILD_DIR) .
	@echo ""
	@echo "Build complete ($(GIT_COMMIT))"

build-uno: build-info
	$(CLI) compile --fqbn arduino:avr:uno --libraries $(LIBRARIES) --build-path $(BUILD_DIR)/uno .
	@echo "Arduino Uno build complete ($(GIT_COMMIT))"

build-nano: build-info
	$(CLI) compile --fqbn arduino:avr:nano --libraries $(LIBRARIES) --build-path $(BUILD_DIR)/nano .
	@echo "Arduino Nano build complete ($(GIT_COMMIT))"

build-all: build-uno build-nano
	@echo ""
	@echo "All builds complete."

# ============================================================================
# Upload targets
# ============================================================================

upload: build
	$(CLI) upload --fqbn $(BOARD) --port $(PORT) --input-dir $(BUILD_DIR)

upload-only:
	$(CLI) upload --fqbn $(BOARD) --port $(PORT) --input-dir $(BUILD_DIR)

# ============================================================================
# Utility targets
# ============================================================================

clean:
	rm -rf $(BUILD_DIR)
	rm -f $(BUILD_INFO_CPP)

monitor:
	$(CLI) monitor --port $(PORT) --config baudrate=$(BAUD)

list-boards:
	$(CLI) board list

size: build
	@echo "Memory usage:"
	@$(CLI) compile --fqbn $(BOARD) --libraries $(LIBRARIES) --build-path $(BUILD_DIR) . 2>&1 | grep -E "(Sketch|Global|Memory)"

build-verbose: build-info
	$(CLI) compile --fqbn $(BOARD) --libraries $(LIBRARIES) --build-path $(BUILD_DIR) --verbose .

# ============================================================================
# Help
# ============================================================================

help:
	@echo "LTP 328P Dual Strip - Arduino Build System"
	@echo ""
	@echo "Hardware: ATmega328P, WS2812 (D8) + APA102 (D3/D2), 2 buttons (A4/A5)"
	@echo "Only one strip active at a time, switchable via active_strip control."
	@echo ""
	@echo "First-time setup:"
	@echo "  make setup          - Install Arduino AVR core"
	@echo ""
	@echo "Build targets:"
	@echo "  make build          - Compile for current BOARD"
	@echo "  make build-uno      - Build for Arduino Uno"
	@echo "  make build-nano     - Build for Arduino Nano"
	@echo "  make build-all      - Build all variants"
	@echo ""
	@echo "Upload:"
	@echo "  make upload         - Build and upload"
	@echo "  make upload-only    - Upload without rebuilding"
	@echo ""
	@echo "Utilities:"
	@echo "  make monitor        - Open serial monitor"
	@echo "  make list-boards    - Show connected boards"
	@echo "  make size           - Show memory usage"
	@echo "  make clean          - Remove build artifacts"
	@echo ""
	@echo "Configuration variables:"
	@echo "  BOARD=$(BOARD)"
	@echo "  PORT=$(PORT)"
	@echo "  BAUD=$(BAUD)"
	@echo ""
	@echo "Examples:"
	@echo "  make upload PORT=/dev/ttyUSB0"
	@echo "  make build-nano"
	@echo "  make upload BOARD=arduino:avr:nano PORT=/dev/ttyUSB0"
