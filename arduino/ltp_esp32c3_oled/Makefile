# LTP ESP32-C3 OLED Sink - Build Makefile
#
# Uses arduino-cli for command-line builds without IDE.
#
# First-time setup:
#   make setup          # Install ESP32 core and libraries
#
# Build and upload:
#   make upload PORT=/dev/ttyUSB0

# Configuration - modify for your setup
BOARD ?= esp32:esp32:esp32c3
PORT ?= /dev/ttyUSB0
BAUD ?= 115200

# Build flags for ESP32-C3
UPLOAD_SPEED ?= 921600
PARTITION_SCHEME ?= default

# Sketch info
SKETCH = ltp_esp32c3_oled.ino
BUILD_DIR = build

# arduino-cli executable
CLI = arduino-cli

# Version info (embedded at compile time via generated build_info.cpp)
GIT_COMMIT := $(shell git rev-parse --short=7 HEAD 2>/dev/null || echo "unknown")$(shell git diff --quiet 2>/dev/null || echo "+")
BUILD_DATE := $(shell date +%Y%m%d)
BUILD_INFO_CPP = build_info.cpp

# Shared libraries directory (local)
LIBRARIES = ../libraries

# ESP32 board URL
ESP32_URL = https://raw.githubusercontent.com/espressif/arduino-esp32/gh-pages/package_esp32_index.json

# ArduinoJson library (for sink protocol)
ARDUINOJSON_VERSION = 7.4.2

# u8g2 library (for OLED display)
U8G2_VERSION = 2.35.30

.PHONY: all build upload clean setup monitor cores list-boards help \
	build-verbose upload-only size install-libs build-info

# Default target
all: build

# Generate build_info.cpp with version stamps
build-info:
	@echo "// Auto-generated by Makefile - do not edit" > $(BUILD_INFO_CPP)
	@echo "const char* GIT_COMMIT = \"$(GIT_COMMIT)\";" >> $(BUILD_INFO_CPP)
	@echo "const char* BUILD_DATE = \"$(BUILD_DATE)\";" >> $(BUILD_INFO_CPP)

# First-time setup - install ESP32 core and libraries
setup:
	$(CLI) config init || true
	$(CLI) config add board_manager.additional_urls $(ESP32_URL) || true
	$(CLI) core update-index
	$(CLI) core install esp32:esp32
	@echo ""
	@echo "Installing required libraries..."
	$(CLI) lib update-index
	$(CLI) lib install "ArduinoJson@$(ARDUINOJSON_VERSION)"
	$(CLI) lib install "U8g2@$(U8G2_VERSION)"
	@echo ""
	@echo "Setup complete. You can now build with 'make build'"

# Install/update libraries only
install-libs:
	$(CLI) lib update-index
	$(CLI) lib install "ArduinoJson@$(ARDUINOJSON_VERSION)"
	$(CLI) lib install "U8g2@$(U8G2_VERSION)"
	@echo "Libraries installed/updated."

# Compile the sketch
build: build-info
	$(CLI) compile \
		--fqbn $(BOARD) \
		--libraries $(LIBRARIES) \
		--build-path $(BUILD_DIR) \
		--build-property "build.partitions=$(PARTITION_SCHEME)" \
		.
	@echo ""
	@echo "Build complete. Git: $(GIT_COMMIT) Date: $(BUILD_DATE)"
	@echo "Binary size:"
	@ls -lh $(BUILD_DIR)/$(SKETCH).bin 2>/dev/null || true

# Upload to board
upload: build
	$(CLI) upload \
		--fqbn $(BOARD) \
		--port $(PORT) \
		--input-dir $(BUILD_DIR)
	@echo ""
	@echo "Upload complete."

# Upload without rebuilding
upload-only:
	$(CLI) upload \
		--fqbn $(BOARD) \
		--port $(PORT) \
		--input-dir $(BUILD_DIR)

# Clean build artifacts
clean:
	rm -rf $(BUILD_DIR)
	rm -f $(BUILD_INFO_CPP)
	@echo "Build directory cleaned."

# Open serial monitor
monitor:
	$(CLI) monitor --port $(PORT) --config baudrate=$(BAUD)

# List available cores
cores:
	$(CLI) core list

# List connected boards
list-boards:
	$(CLI) board list

# Show available ESP32 board variants
boards:
	$(CLI) board listall | grep -i esp32 | head -20

# Compile with verbose output
build-verbose: build-info
	$(CLI) compile \
		--fqbn $(BOARD) \
		--libraries $(LIBRARIES) \
		--build-path $(BUILD_DIR) \
		--verbose \
		.

# Show memory usage
size: build
	@echo "Memory usage:"
	@$(CLI) compile \
		--fqbn $(BOARD) \
		--libraries $(LIBRARIES) \
		--build-path $(BUILD_DIR) \
		. 2>&1 | grep -E "(Sketch|Global|Memory|Flash|RAM)" || true

# ============================================================================
# Flash tools
# ============================================================================

# Erase flash completely
erase:
	python3 -m esptool --port $(PORT) erase_flash
	@echo "Flash erased."

# Flash with bootloader (full flash)
flash-full: build
	python3 -m esptool --port $(PORT) \
		--baud $(UPLOAD_SPEED) \
		write_flash \
		0x0 $(BUILD_DIR)/$(SKETCH).ino.bootloader.bin \
		0x8000 $(BUILD_DIR)/$(SKETCH).ino.partitions.bin \
		0x10000 $(BUILD_DIR)/$(SKETCH).bin

# ============================================================================
# Distribution
# ============================================================================

# Create distributable binary
dist: build-info
	$(CLI) compile \
		--fqbn $(BOARD) \
		--libraries $(LIBRARIES) \
		--build-path $(BUILD_DIR) \
		.
	@cp $(BUILD_DIR)/$(SKETCH).bin ltp_esp32c3_oled.bin
	@echo "Distributable binary: ltp_esp32c3_oled.bin ($(GIT_COMMIT))"
	@ls -lh ltp_esp32c3_oled.bin

# ============================================================================
# Help
# ============================================================================

help:
	@echo "LTP ESP32-C3 OLED Sink - Build System"
	@echo ""
	@echo "First-time setup:"
	@echo "  make setup          - Install ESP32 core and libraries"
	@echo "  make install-libs   - Install/update libraries only"
	@echo ""
	@echo "Build targets:"
	@echo "  make build          - Compile for ESP32-C3"
	@echo "  make upload         - Compile and upload"
	@echo "  make upload-only    - Upload without rebuilding"
	@echo "  make clean          - Remove build artifacts"
	@echo ""
	@echo "Flash tools:"
	@echo "  make erase          - Erase flash completely"
	@echo "  make flash-full     - Flash bootloader + app"
	@echo ""
	@echo "Distribution:"
	@echo "  make dist           - Create distributable binary"
	@echo ""
	@echo "Utilities:"
	@echo "  make monitor        - Open serial monitor"
	@echo "  make list-boards    - Show connected boards"
	@echo "  make size           - Show memory usage"
	@echo ""
	@echo "Configuration variables:"
	@echo "  BOARD=$(BOARD)"
	@echo "  PORT=$(PORT)"
	@echo "  BAUD=$(BAUD)"
	@echo "  UPLOAD_SPEED=$(UPLOAD_SPEED)"
	@echo ""
	@echo "Examples:"
	@echo "  make upload PORT=/dev/ttyACM0"
	@echo "  make monitor PORT=/dev/ttyACM0"
