# LTP Stream (serial) - Arduino Build Makefile
#
# Pattern-only LED controller: LTP serial protocol v2 without pixel data.
# Patterns are calculated while the frame is sent; there is no frame buffer.
#
# Boards: ATmega328P (Arduino Uno / Nano) and Teensy 3.2.
#
# Uses arduino-cli for building.
#
# First-time setup:
#   make setup            # Arduino AVR core
#   make setup-teensy     # Teensy core
#
# Build and upload:
#   make upload PORT=/dev/ttyUSB0
#   make upload-teensy32

# Configuration
BOARD ?= arduino:avr:nano:cpu=atmega328old
PORT ?= /dev/ttyUSB0
BAUD ?= 115200

# Sketch info
SKETCH = ltp_stream_serial.ino
BUILD_DIR = build

# Tools
CLI = arduino-cli

# Version info (embedded at compile time via generated build_info.cpp)
GIT_COMMIT := $(shell git rev-parse --short=7 HEAD 2>/dev/null || echo "unknown")$(shell git diff --quiet 2>/dev/null || echo "+")
BUILD_DATE := $(shell date +%Y%m%d)
BUILD_INFO_CPP = build_info.cpp

# Shared libraries directory
LIBRARIES = ../libraries

TEENSY32 = teensy:avr:teensy31
TEENSY_URL = https://www.pjrc.com/teensy/package_teensy_index.json

.PHONY: all build build-uno build-nano build-teensy32 build-all upload upload-only \
	upload-teensy32 clean setup setup-teensy monitor list-boards size sim-test help build-info

# Default target
all: build

# Generate build_info.cpp with version stamps
build-info:
	@echo "// Auto-generated by Makefile - do not edit" > $(BUILD_INFO_CPP)
	@echo "const char* GIT_COMMIT = \"$(GIT_COMMIT)\";" >> $(BUILD_INFO_CPP)
	@echo "const char* BUILD_DATE = \"$(BUILD_DATE)\";" >> $(BUILD_INFO_CPP)

# First-time setup - install Arduino AVR core
setup:
	$(CLI) config init || true
	$(CLI) core update-index
	$(CLI) core install arduino:avr
	@echo ""
	@echo "Setup complete. Run 'make setup-teensy' for Teensy support."

setup-teensy:
	$(CLI) config add board_manager.additional_urls $(TEENSY_URL) || true
	$(CLI) core update-index
	$(CLI) core install teensy:avr
	@echo ""
	@echo "Teensy core installed."

# ============================================================================
# Build targets
# ============================================================================

build: build-info
	$(CLI) compile --fqbn $(BOARD) --libraries $(LIBRARIES) --build-path $(BUILD_DIR) .
	@echo ""
	@echo "Build complete ($(GIT_COMMIT))"

build-uno: build-info
	$(CLI) compile --fqbn arduino:avr:uno --libraries $(LIBRARIES) --build-path $(BUILD_DIR)/uno .
	@echo "Arduino Uno build complete ($(GIT_COMMIT))"

build-nano: build-info
	$(CLI) compile --fqbn arduino:avr:nano --libraries $(LIBRARIES) --build-path $(BUILD_DIR)/nano .
	@echo "Arduino Nano build complete ($(GIT_COMMIT))"

build-teensy32: build-info
	$(CLI) compile --fqbn $(TEENSY32) --libraries $(LIBRARIES) --build-path $(BUILD_DIR)/teensy32 .
	@echo "Teensy 3.2 build complete ($(GIT_COMMIT))"

build-all: build-uno build-nano build-teensy32
	@echo ""
	@echo "All builds complete."

# ============================================================================
# Upload targets
# ============================================================================

upload: build
	$(CLI) upload --fqbn $(BOARD) --port $(PORT) --input-dir $(BUILD_DIR)

upload-only:
	$(CLI) upload --fqbn $(BOARD) --port $(PORT) --input-dir $(BUILD_DIR)

upload-teensy32: build-teensy32
	$(CLI) upload --fqbn $(TEENSY32) --port $(PORT) --input-dir $(BUILD_DIR)/teensy32

# ============================================================================
# Utility targets
# ============================================================================

clean:
	rm -rf $(BUILD_DIR)
	rm -f $(BUILD_INFO_CPP)

monitor:
	$(CLI) monitor --port $(PORT) --config baudrate=$(BAUD)

list-boards:
	$(CLI) board list

size: build
	@echo "Memory usage:"
	@$(CLI) compile --fqbn $(BOARD) --libraries $(LIBRARIES) --build-path $(BUILD_DIR) . 2>&1 | grep -E "(Sketch|Global|Memory)"

# Run the Uno build on a simulated ATmega328P: talks the serial protocol to
# it and measures the WS2812 waveform. Needs Node.js; see sim/README.md.
sim-test: build-uno
	cd sim && npm install --silent && node run_sim.js ../$(BUILD_DIR)/uno/$(SKETCH).hex

# ============================================================================
# Help
# ============================================================================

help:
	@echo "LTP Stream (serial) - Arduino Build System"
	@echo ""
	@echo "Pattern-only LED controller, no pixel data, no frame buffer."
	@echo "  ATmega328P: WS2812 on D8, APA102 on D3 (data) / D2 (clock)"
	@echo "  Teensy 3.2: WS2812 on pin 2, APA102 or LPD8806 on SPI (11 / 13)"
	@echo ""
	@echo "First-time setup:"
	@echo "  make setup            - Install Arduino AVR core"
	@echo "  make setup-teensy     - Install Teensy core"
	@echo ""
	@echo "Build targets:"
	@echo "  make build            - Compile for current BOARD"
	@echo "  make build-uno        - Build for Arduino Uno"
	@echo "  make build-nano       - Build for Arduino Nano"
	@echo "  make build-teensy32   - Build for Teensy 3.2"
	@echo "  make build-all        - Build all variants"
	@echo ""
	@echo "Upload:"
	@echo "  make upload           - Build and upload (current BOARD)"
	@echo "  make upload-only      - Upload without rebuilding"
	@echo "  make upload-teensy32  - Build and upload to a Teensy 3.2"
	@echo ""
	@echo "Utilities:"
	@echo "  make monitor          - Open serial monitor"
	@echo "  make list-boards      - Show connected boards"
	@echo "  make size             - Show memory usage"
	@echo "  make sim-test         - Protocol and WS2812 timing test on a simulated 328P"
	@echo "  make clean            - Remove build artifacts"
	@echo ""
	@echo "Configuration variables:"
	@echo "  BOARD=$(BOARD)"
	@echo "  PORT=$(PORT)"
	@echo "  BAUD=$(BAUD)"
	@echo ""
	@echo "Examples:"
	@echo "  make upload PORT=/dev/ttyUSB0"
	@echo "  make upload BOARD=arduino:avr:uno PORT=/dev/ttyACM0"
